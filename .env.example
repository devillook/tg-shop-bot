BOT_TOKEN=
ADMIN_IDS=8280952805
ADMIN_USERNAME=jonnkq

# my.telegram.org -> API development tools
API_ID=
API_HASH=

# сессия твоего аккаунта @jonnkq (создаётся командой: python login_owner.py)
OWNER_SESSION=owner

# БЕТА-ТЕСТ: 1 = любое сообщение, написанное на аккаунт @jonnkq, считается оплатой. После тестов поставь 0!
BETA_MODE=1
# необязательно: ID, которым разрешён бета-тест (через запятую). Пусто = всем.
BETA_USER_IDS=

# Время на оплату после нажатия «Оплатить», минут
PAYMENT_MINUTES=5
# Время на вход в аккаунт после оплаты, часов (потом сессия продавца закрывается)
ACCESS_HOURS=5
# Допуск на комиссию подарка, %: при цене 15 ⭐ и допуске 15% хватит подарка от ~12,75 ⭐
GIFT_TOLERANCE_PERCENT=15

# Стартовые цифры статистики (к ним прибавляются реальные покупки и пользователи)
STATS_BASE_SOLD=15
STATS_BASE_USERS=24

# Канал, подписка на который обязательна для пользования ботом (без @). Бот ДОЛЖЕН быть
# добавлен в этот канал (лучше администратором) — иначе проверка подписки не заработает.
SUB_CHANNEL=codcrytg
# Сколько токенов начисляется за каждого приглашённого друга (засчитывается по его первому /start)
REFERRAL_BONUS_TOKENS=5

# Только для хостинга: путь к папке с постоянным диском (см. ДЕПЛОЙ.txt). Локально не трогай.
# DATA_DIR=/data
